BOT_TOKEN=replace_with_botfather_token
ADMIN_ID=replace_with_telegram_user_id

# Solana RPC
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Jupiter API (used as the default swap/quote adapter)
JUPITER_BASE_URL=https://api.jup.ag
JUPITER_API_KEY=

# Optional FluxBeam-compatible API adapter. Leave blank until the official
# API endpoint/key is configured for your account.
FLUXBEAM_API_BASE_URL=
FLUXBEAM_API_KEY=

# Database
DATABASE_PATH=bot.sqlite3
