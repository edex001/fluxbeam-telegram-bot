BOT_TOKEN=replace_with_botfather_token
ADMIN_ID=replace_with_telegram_user_id

# Required for encrypted wallet storage. Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
WALLET_ENCRYPTION_KEY=replace_with_fernet_key
WALLET_DB_PATH=data/wallets.db

# Solana RPC
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Jupiter quote/swap adapter
JUPITER_BASE_URL=https://api.jup.ag
JUPITER_API_KEY=

# Default trade slippage in basis points (100 = 1%)
DEFAULT_SLIPPAGE_BPS=100

# Optional FluxBeam API adapter. Leave blank unless you have official API docs/credentials.
FLUXBEAM_API_BASE_URL=
FLUXBEAM_API_KEY=
